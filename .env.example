# Used by docker-compose.yml only (the npm workflow uses backend/.env and
# frontend/.env instead — see their own .env.example files).

# Postgres (the `db` service, and backend's DATABASE_URL/DIRECT_URL)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=portfolio

# Backend
JWT_SECRET="change-me-to-a-long-random-string"
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""
FRONTEND_ORIGIN="http://localhost:5173"
# Only set to "true" if you put this stack behind HTTPS (e.g. a reverse proxy)
COOKIE_SECURE="false"

# Frontend (baked into the JS bundle at build time)
VITE_API_URL="http://localhost:4000/api"
