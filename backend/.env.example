# Supabase: pooled connection (Transaction pooler, port 6543) — used by the app at runtime
DATABASE_URL="postgresql://user:password@host:6543/postgres?pgbouncer=true&connection_limit=1"

# Supabase: direct connection (port 5432) — used only by Prisma Migrate
DIRECT_URL="postgresql://user:password@host:5432/postgres"

# Random long secret used to sign admin JWTs
JWT_SECRET="change-me-to-a-long-random-string"

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Used only by `npm run seed` to create/update the single Admin user
SEED_ADMIN_USERNAME=""
SEED_ADMIN_PASSWORD=""

# Server
PORT=4000
NODE_ENV=development

# Allowed CORS origin(s). Comma-separated if more than one. Defaults to
# localhost:5173 if unset — set this explicitly in production (e.g. the
# Vercel frontend URL) since setting it replaces the localhost default.
FRONTEND_ORIGIN="http://localhost:5173"

# Set to "true" only when the site is served over HTTPS. Also controls the
# cookie's SameSite mode: "false" -> Lax (same-site local dev), "true" -> None
# (required for cross-domain cookies, e.g. Vercel frontend + Render backend).
COOKIE_SECURE="false"
